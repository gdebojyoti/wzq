{
  "name": "@wzq/web",
  "version": "0.0.0",
  "private": true,
  "description": "The WZQ web app: React and Webpack 5, a Module Federation remote.",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "prebuild": "npm run build -w @wzq/shared",
