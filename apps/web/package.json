    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wzq/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "dotenv-webpack": "^9.0.0",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
