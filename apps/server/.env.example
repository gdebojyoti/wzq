# Port the server listens on. Render sets this itself.
PORT=4000
# Addresses of the web app, the only origins allowed to call the server (CORS). Separate several with commas.
WEB_ORIGIN=http://localhost:8081
# Where a Player plays WZQ in a browser, which an AI Player sends them to. Required on Render, where it's
# https://tablehop.games/wzq: the server won't start there without it.
WEB_APP_URL=http://localhost:8081/wzq
